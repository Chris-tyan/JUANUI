
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Sign Up - JuanUI App</title>
</head>
<body style="margin:0;font-family:Arial,sans-serif;background:#f3f4f6;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;">

<div style="background:white;width:100%;max-width:420px;border-radius:12px;overflow:hidden;box-shadow:0 8px 25px rgba(0,0,0,0.1);">

    <div style="background:linear-gradient(135deg,#4338ca,#312e81);color:white;text-align:center;padding:25px;">
        <a href="/" style="display:block;text-align:left;color:white;text-decoration:none;">← Back to Home</a>
        <h1>💻 JuanUI App</h1>
        <h2 style="margin:0;font-weight:normal;">Student Sign Up</h2>
    </div>

    <div style="padding:28px;">

        <% if (error) { %>
            <p style="background:#fee2e2;color:#b91c1c;padding:12px;border-radius:6px;"><%= error %></p>
        <% } %>

        <form action="/signup" method="POST">
            <label for="name" style="display:block;margin-bottom:6px;font-weight:bold;">Full Name</label>
            <input id="name" type="text" name="name" placeholder="Enter your full name" required style="box-sizing:border-box;width:100%;padding:12px;border:1px solid #d1d5db;border-radius:6px;margin-bottom:17px;">

            <label for="email" style="display:block;margin-bottom:6px;font-weight:bold;">Email Address</label>
            <input id="email" type="email" name="email" placeholder="Enter your email" required style="box-sizing:border-box;width:100%;padding:12px;border:1px solid #d1d5db;border-radius:6px;margin-bottom:17px;">

            <label for="password" style="display:block;margin-bottom:6px;font-weight:bold;">Password</label>
            <input id="password" type="password" name="password" minlength="6" placeholder="At least 6 characters" required style="box-sizing:border-box;width:100%;padding:12px;border:1px solid #d1d5db;border-radius:6px;margin-bottom:17px;">

            <label for="confirm-password" style="display:block;margin-bottom:6px;font-weight:bold;">Confirm Password</label>
            <input id="confirm-password" type="password" name="confirm-password" placeholder="Repeat your password" required style="box-sizing:border-box;width:100%;padding:12px;border:1px solid #d1d5db;border-radius:6px;margin-bottom:17px;">

            <label style="display:flex;gap:8px;align-items:flex-start;font-size:14px;margin-bottom:20px;">
                <input type="checkbox" name="terms" required>
                <span>I agree to the terms and privacy policy.</span>
            </label>

            <button type="submit" style="width:100%;padding:13px;background:#f97316;color:white;border:0;border-radius:6px;font-size:16px;font-weight:bold;cursor:pointer;">Create Account</button>
        </form>

        <p style="text-align:center;">Already have an account? <a href="/login" style="color:#ea580c;text-decoration:none;font-weight:bold;">Log In</a></p>
    </div>
</div>

</body>
</html>
